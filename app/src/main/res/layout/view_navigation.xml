<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/navigation_width"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sidebar"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <Button
        android:layout_width="match_parent"
        android:layout_height="@dimen/navigation_item_height"
        android:id="@+id/menu_music"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_navigation_button"
        android:text="@string/menu_music"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textAllCaps="false"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:drawableStart="@drawable/ic_menu_music"
        android:drawablePadding="12dp" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="@dimen/navigation_item_height"
        android:id="@+id/menu_radio"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_navigation_button"
        android:text="@string/menu_radio"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textAllCaps="false"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:drawableStart="@drawable/ic_menu_radio"
        android:drawablePadding="12dp" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="@dimen/navigation_item_height"
        android:id="@+id/menu_settings"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_navigation_button"
        android:text="@string/menu_settings"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textAllCaps="false"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:drawableStart="@drawable/ic_menu_settings"
        android:drawablePadding="12dp" />

</LinearLayout>
